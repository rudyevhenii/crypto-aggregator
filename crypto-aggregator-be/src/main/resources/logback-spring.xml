<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Reuse Spring Boot's own console pattern variables -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Overridable via env var, e.g. LOG_PATH=/tmp/logs -->
    <property name="LOG_PATH" value="${LOG_PATH:-build/logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-application}"/>

    <!-- Single file appender mirroring the console pattern (no rotation) -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <append>false</append>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
