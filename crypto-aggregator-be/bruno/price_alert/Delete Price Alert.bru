meta {
  name: Delete Price Alert
  type: http
  seq: 5
}

delete {
  url: {{BASE_URL}}/api/price-alerts/:priceAlertId
  body: none
  auth: inherit
}

params:path {
  priceAlertId: {{PRICE_ALERT_ID}}
}

body:json {
  {
    "targetPrice": 82000.50,
    "conditionType": "LESS_THAN",
    "isRecurring": false,
    "cooldownMinutes": 2,
    "deliveryMethods": [
      "EMAIL"
    ],
    "expiresAt": "2026-11-01T10:00:00Z"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
