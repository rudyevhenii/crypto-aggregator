meta {
  name: Create Price Alert
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/price-alerts
  body: json
  auth: inherit
}

body:json {
  {
    "exchange": "BINANCE",
    "tradingPair": "BTC_USD",
    "targetPrice": 85000.00,
    "conditionType": "GREATER_THAN",
    "isRecurring": true,
    "cooldownMinutes": 5,
    "deliveryMethods": [
      "EMAIL"
    ],
    "expiresAt": "2026-12-31T23:59:59Z"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("PRICE_ALERT_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
