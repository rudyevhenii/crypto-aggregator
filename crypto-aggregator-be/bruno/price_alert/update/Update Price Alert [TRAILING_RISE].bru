meta {
  name: Update Price Alert [TRAILING_RISE]
  type: http
  seq: 8
}

patch {
  url: {{BASE_URL}}/api/price-alerts/:priceAlertId
  body: json
  auth: inherit
}

params:path {
  priceAlertId: {{PRICE_ALERT_TRAILING_RISE_ID}}
}

body:json {
  {
    "triggerPolicy": {
      "triggerType": "RECURRING",
      "cooldownMinutes": 4
    },
    "deliveryMethods": [
      "EMAIL"
    ],
    "conditionPayload": {
      "conditionType": "TRAILING_RISE",
      "trailingPercentage": 5.0,
      "referencePrice": 2800.00
    },
    "expiresAt": null
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("PRICE_ALERT_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
