meta {
  name: Update Price Alert [CROSSED_DOWN]
  type: http
  seq: 4
}

patch {
  url: {{BASE_URL}}/api/price-alerts/:priceAlertId
  body: json
  auth: inherit
}

params:path {
  priceAlertId: {{PRICE_ALERT_CROSSED_DOWN_ID}}
}

body:json {
  {
    "recurring": true,
    "cooldownMinutes": 30,
    "deliveryMethods": [
      "EMAIL"
    ],
    "conditionPayload": {
      "conditionType": "CROSSED_DOWN",
      "targetPrice": 0.40
    },
    "expiresAt": null
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("PRICE_ALERT_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
