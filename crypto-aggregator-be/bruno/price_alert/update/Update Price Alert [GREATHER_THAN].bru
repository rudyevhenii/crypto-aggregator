meta {
  name: Update Price Alert [GREATHER_THAN]
  type: http
  seq: 1
}

patch {
  url: {{BASE_URL}}/api/price-alerts/:priceAlertId
  body: json
  auth: inherit
}

params:path {
  priceAlertId: {{PRICE_ALERT_GREATER_THAN_ID}}
}

body:json {
  {
    "recurring": true,
    "cooldownMinutes": 10,
    "deliveryMethods": [
      "EMAIL"
    ],
    "conditionPayload": {
      "conditionType": "GREATER_THAN",
      "targetPrice": 88000.00
    },
    "expiresAt": "2026-12-31T23:59:59Z"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("PRICE_ALERT_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
