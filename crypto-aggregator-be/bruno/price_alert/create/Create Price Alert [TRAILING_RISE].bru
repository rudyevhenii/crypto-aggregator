meta {
  name: Create Price Alert [TRAILING_RISE]
  type: http
  seq: 8
}

post {
  url: {{BASE_URL}}/api/price-alerts
  body: json
  auth: inherit
}

body:json {
  {
    "exchange": "BINANCE",
    "tradingPair": "ETH_USD",
    "triggerPolicy": {
      "triggerType": "ONE_TIME"
    },
    "deliveryMethods": [
      "EMAIL"
    ],
    "conditionPayload": {
      "conditionType": "TRAILING_RISE",
      "trailingPercentage": 4.5,
      "referencePrice": 2950.00
    },
    "expiresAt": null
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("PRICE_ALERT_TRAILING_RISE_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
