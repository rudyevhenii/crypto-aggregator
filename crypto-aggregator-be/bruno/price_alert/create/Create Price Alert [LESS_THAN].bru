meta {
  name: Create Price Alert [LESS_THAN]
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/price-alerts
  body: json
  auth: inherit
}

body:json {
  {
    "exchange": "BINANCE",
    "tradingPair": "ETH_USD",
    "cooldownMinutes": 15,
    "deliveryMethods": [
      "EMAIL"
    ],
    "conditionPayload": {
      "conditionType": "LESS_THAN",
      "targetPrice": 2500.50
    },
    "expiresAt": null
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("PRICE_ALERT_LESS_THAN_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
