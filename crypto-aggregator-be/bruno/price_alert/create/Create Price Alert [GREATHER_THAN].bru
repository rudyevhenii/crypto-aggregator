meta {
  name: Create Price Alert [GREATHER_THAN]
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/price-alerts
  body: json
  auth: inherit
}

body:json {
  {
    "exchange": "BINANCE",
    "tradingPair": "BTC_USD",
    "triggerPolicy": {
      "triggerType": "RECURRING",
      "cooldownMinutes": 9
    },
    "deliveryMethods": [
      "EMAIL"
    ],
    "conditionPayload": {
      "conditionType": "GREATER_THAN",
      "targetPrice": 85000.00
    },
    "expiresAt": "2026-12-31T23:59:59Z"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("PRICE_ALERT_GREATER_THAN_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
