meta {
  name: Search Exchange Pairs
  type: http
  seq: 14
}

get {
  url: {{BASE_URL}}/api/exchange-pairs/search?exchange=BINANCE&tradingPair=A
  body: none
  auth: inherit
}

params:query {
  exchange: BINANCE
  tradingPair: A
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    
    if (Array.isArray(body) && body.length > 0) {
      bru.setVar("EXCHANGE_PAIR_ID", body[0].id);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
