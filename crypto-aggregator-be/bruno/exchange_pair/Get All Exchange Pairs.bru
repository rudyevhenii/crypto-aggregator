meta {
  name: Get All Exchange Pairs
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/api/exchange-pairs
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    
    if (Array.isArray(body) && body.length > 0) {
      bru.setVar("EXCHANGE_PAIR_ID", body[0].id);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
