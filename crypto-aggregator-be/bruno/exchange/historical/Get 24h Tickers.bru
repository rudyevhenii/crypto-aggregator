meta {
  name: Get 24h Tickers
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/api/historical/exchanges/:exchange/tickers/24h?tradingPairs=BTC_USD,ETH_USD,SOL_USD
  body: none
  auth: inherit
}

params:query {
  tradingPairs: BTC_USD,ETH_USD,SOL_USD
}

params:path {
  exchange: BINANCE
}

settings {
  encodeUrl: true
  timeout: 0
}
