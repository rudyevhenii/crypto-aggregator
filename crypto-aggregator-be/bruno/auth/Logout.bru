meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/auth/logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "accessToken": "{{ACCESS_TOKEN}}",
    "refreshToken": "{{REFRESH_TOKEN}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
