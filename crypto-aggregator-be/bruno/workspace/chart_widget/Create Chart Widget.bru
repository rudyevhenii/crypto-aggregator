meta {
  name: Create Chart Widget
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/workspaces/:workspaceId/widgets
  body: json
  auth: inherit
}

params:path {
  workspaceId: {{WORKSPACE_ID}}
}

body:json {
  {
    "exchangePairId": "{{EXCHANGE_PAIR_ID}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("CHART_WIDGET_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
