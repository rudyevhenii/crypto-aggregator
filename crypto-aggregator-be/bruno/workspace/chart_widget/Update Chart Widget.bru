meta {
  name: Update Chart Widget
  type: http
  seq: 2
}

patch {
  url: {{BASE_URL}}/api/workspaces/:workspaceId/widgets/:chartWidgetId
  body: json
  auth: inherit
}

params:path {
  workspaceId: {{WORKSPACE_ID}}
  chartWidgetId: {{CHART_WIDGET_ID}}
}

body:json {
  {
    "chartInterval": "ONE_HOUR"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
