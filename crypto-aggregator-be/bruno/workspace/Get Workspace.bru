meta {
  name: Get Workspace
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/api/workspaces/:workspaceId
  body: none
  auth: inherit
}

params:path {
  workspaceId: {{WORKSPACE_ID}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("WORKSPACE_ID", res.getBody().id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
